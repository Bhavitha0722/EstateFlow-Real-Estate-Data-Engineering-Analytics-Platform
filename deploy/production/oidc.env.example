# Production-only OIDC and secret-manager examples.
# Copy to a secret store or CI/CD environment variable set.
# Never commit real values to git.

ENVIRONMENT=production

OIDC_ISSUER=https://identity.example.com/realms/analytics
OIDC_AUDIENCE=real-estate-analytics
OIDC_JWKS_URL=https://identity.example.com/realms/analytics/protocol/openid-connect/certs
OIDC_ROLES_CLAIM=roles

OPERATIONS_API_KEY=replace-with-managed-secret
AIRFLOW_PASSWORD=replace-with-managed-secret
POSTGRES_PASSWORD=replace-with-managed-secret
FERNET_KEY=replace-with-managed-secret
ALERT_WEBHOOK_URL=replace-with-managed-secret

# Optional: if using a managed secret manager, the runtime container can resolve these values automatically.
# Example: AWS Secrets Manager, Azure Key Vault, Kubernetes Secret, or HashiCorp Vault.
