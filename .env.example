# Copy this file to .env for local development.
# Never commit .env or production credentials.

POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow
AIRFLOW_UID=50000
AIRFLOW_DATA_DIR=/opt/airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=10
OIDC_ISSUER=https://identity.example.com/realms/analytics
OIDC_AUDIENCE=real-estate-analytics
OIDC_JWKS_URL=https://identity.example.com/realms/analytics/protocol/openid-connect/certs
OIDC_ROLES_CLAIM=roles
AIRFLOW_API_URL=http://webserver:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me
OPERATIONS_API_KEY=replace-with-a-long-random-value
FRESHNESS_THRESHOLD_HOURS=24
DATA_QUALITY_MIN_ROWS=40000
DATA_QUALITY_MAX_ROWS=60000
DATA_QUALITY_MAX_NULL_RATE=0.25
DATA_QUALITY_MIN_PRICE=0
DATA_QUALITY_MAX_PRICE=10000

# Optional failure notifications. Leave empty to disable external alerts locally.
ALERT_WEBHOOK_URL=

# Required for CeleryExecutor. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Leave SMTP_USER and SMTP_PASSWORD empty to disable email delivery locally.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_MAIL_FROM=
SMTP_STARTTLS=True
SMTP_SSL=False
